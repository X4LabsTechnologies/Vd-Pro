# ============================================
# Vd-Pro Environment Variables (EXAMPLE ONLY)
# انسخ هذا الملف إلى .env محلياً واملأ القيم
# على Render: ضع نفس المفاتيح في Environment
# ============================================

# بيئة التشغيل
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# مطلوب في الإنتاج — 32 حرف على الأقل (عشوائي قوي)
# مثال توليد: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars

# MongoDB (Atlas أو محلي)
# مثال Atlas:
# MONGODB_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/vd-pro?retryWrites=true&w=majority
MONGODB_URL=mongodb://localhost:27017/vd-pro

# Redis
# مثال Redis Cloud:
# REDIS_URL=redis://default:PASSWORD@host:port
REDIS_URL=redis://localhost:6379

# بروكسيات اختيارية (مفصولة بفاصلة)
# مثال: http://user:pass@host:port,http://host2:port
PROXIES=

# CORS — نطاقات مسموحة مفصولة بفاصلة (اتركه فارغاً للسماح للجميع مؤقتاً)
# مثال: https://yourfrontend.com,https://admin.yourfrontend.com
ALLOWED_ORIGINS=

# مهلات الاستخراج والبحث
HARD_EXTRACT_MS=110000
HARD_SEARCH_MS=30000
NAV_TIMEOUT_MS=45000
JOB_PROCESS_TIMEOUT_MS=170000
FALLBACK_BUDGET_MS=30000
WATCHDOG_INTERVAL_MS=15000

# مدة انتظار استقرار طلبات الوسائط بعد التفاعل
MEDIA_IDLE_WAIT_MS=8000

# تشغيل سريع على Render: يبدأ HTTP مبكرًا ثم يجهز المتصفح في الخلفية
BROWSER_POOL_COUNT=1
BROWSER_CONTEXTS_PER_POOL=2

# Proxy اختياري عام (لا يُستخدم إذا كان فارغًا)
# PROXY_URL=http://user:pass@host:port
# VD_PROXY_URL=http://host:port
# VD_PROXY_URLS=http://host1:port,http://host2:port

# MediaFlow HLS proxy (يُفعّل إعادة توجيه روابط HLS فقط عند ضبط كلمة المرور)
# MEDIAFLOW_PROXY_URL=https://mediaflow-proxy-light-37xr.onrender.com
# MEDIAFLOW_PROXY_PASSWORD=ضع_كلمة_مرور_MediaFlow_هنا
# MEDIAFLOW_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# TMDB وOMDb اختياريان لتحسين البحث بالاسم
# TMDB_API_KEY=your_tmdb_api_key
# OMDB_API_KEY=your_omdb_api_key
